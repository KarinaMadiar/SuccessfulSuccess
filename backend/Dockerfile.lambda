# The image AWS Lambda runs (`make aws-push`). The plain Dockerfile stays the
# local/compose image; this one packages the API and static frontend for Lambda.
FROM public.ecr.aws/lambda/python:3.12

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

WORKDIR ${LAMBDA_TASK_ROOT}

# Lambda's filesystem is read-only, so compile the bytecode at build time.
COPY backend/pyproject.toml ./
RUN uv pip install --no-cache --compile-bytecode --target "${LAMBDA_TASK_ROOT}" -r pyproject.toml

COPY backend/alembic.ini ./
COPY backend/alembic ./alembic
COPY backend/app ./app
COPY frontend/out ./static

# Serves the function URL, and runs migrations when invoked with {"action": "migrate"}.
CMD ["app.lambda_handler.handler"]
